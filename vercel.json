{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(login|register|forgot-password|verify-otp|reset-password)",
      "destination": "/auth.html"
    },
    {
      "source": "/admin/(login|forgot-password|verify-otp|reset-password)",
      "destination": "/admin-auth.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    }
  ]
}
