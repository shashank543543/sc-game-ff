<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bermudaBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F2027"/>
      <stop offset="50%" stop-color="#203A43"/>
      <stop offset="100%" stop-color="#2C5364"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF5100"/>
      <stop offset="100%" stop-color="#FFD000"/>
    </linearGradient>
  </defs>
  <rect width="600" height="300" fill="url(#bermudaBg)"/>
  <!-- Map Outline / Grid Elements -->
  <circle cx="300" cy="150" r="100" fill="none" stroke="rgba(255, 81, 0, 0.15)" stroke-width="2"/>
  <circle cx="300" cy="150" r="160" fill="none" stroke="rgba(0, 229, 255, 0.1)" stroke-width="1" stroke-dasharray="8,8"/>
  <line x1="0" y1="150" x2="600" y2="150" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1"/>
  <line x1="300" y1="0" x2="300" y2="300" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1"/>
  <!-- Badge & Name -->
  <rect x="30" y="30" width="120" height="30" rx="6" fill="rgba(0,0,0,0.6)" stroke="#FF5100" stroke-width="1.5"/>
  <text x="90" y="50" font-family="'Rajdhani', sans-serif" font-weight="700" font-size="14" fill="#FF5100" text-anchor="middle">BERMUDA</text>
  <text x="300" y="165" font-family="'Rajdhani', sans-serif" font-weight="800" font-size="46" fill="#FFFFFF" text-anchor="middle" letter-spacing="4">BERMUDA CLASH</text>
  <text x="300" y="195" font-family="'Inter', sans-serif" font-weight="600" font-size="14" fill="url(#accent)" text-anchor="middle" letter-spacing="2">CLOCK TOWER • FACTORY • PEAK</text>
</svg>
